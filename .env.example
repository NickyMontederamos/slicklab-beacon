# Copy to .env (or put in the systemd unit) and fill in.
ANTHROPIC_API_KEY=
# Model used by the content, critic and visibility agents.
BEACON_MODEL=claude-opus-5-5
# "claude" (default) or "fake" (offline, deterministic - for demos and tests).
BEACON_LLM=claude
# Where client data lives. One SQLite file per client under $BEACON_DATA_DIR/clients/<id>/.
BEACON_DATA_DIR=./data
BEACON_PROFILES_DIR=./profiles
# Long random string. Signs web session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BEACON_SECRET_KEY=
# Set to 1 when served over HTTPS (production) so cookies are Secure.
BEACON_HTTPS=0
# Optional: lets the audit compare your Google Business Profile listing.
GOOGLE_PLACES_API_KEY=
