# Copy to .env (or put in the systemd unit) and fill in.
ANTHROPIC_API_KEY=
# Model used by the content, critic and visibility agents.
BEACON_MODEL=claude-opus-5-5
# "claude" (default) or "fake" (offline, deterministic - for demos and tests).
BEACON_LLM=claude
# Where client data lives. One SQLite file per client under $BEACON_DATA_DIR/clients/<id>/.
BEACON_DATA_DIR=./data
BEACON_PROFILES_DIR=./profiles
# Long random string. Signs web session cookies. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
BEACON_SECRET_KEY=
# Set to 1 when served over HTTPS (production) so cookies are Secure.
BEACON_HTTPS=0
# Optional: lets the audit compare your Google Business Profile listing.
GOOGLE_PLACES_API_KEY=

# --- AI visibility runs use a FREE model (drafting and fact-checking still use Claude) ---
# Pick one provider, get a free API key from it, then run `beacon free-models` (OpenRouter) to see
# current free model names. Free model names change often - check before you set this.
#   openrouter -> OPENROUTER_API_KEY   (openrouter.ai, free models end in ":free")
#   groq       -> GROQ_API_KEY         (console.groq.com)
#   gemini     -> GEMINI_API_KEY       (aistudio.google.com)
#   ollama     -> no key, runs on your own machine
BEACON_VISIBILITY_PROVIDER=auto
BEACON_FREE_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Seconds to wait between questions so free tiers don't rate-limit you.
BEACON_FREE_DELAY=3
